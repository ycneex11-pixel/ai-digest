---
import { getEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

// Страница серверная (output: 'server'), поэтому getStaticPaths здесь
// игнорируется — статью грузим по slug из адреса. Пререндерить нельзя:
// статика отдаётся до middleware и обошла бы авторизацию.
const { slug } = Astro.params;
const post = slug ? await getEntry('blog', slug) : undefined;

if (!post) {
	return new Response(null, { status: 404 });
}

const { Content } = await render(post);
---

<BlogPost {...post.data}>
	<Content />
</BlogPost>
