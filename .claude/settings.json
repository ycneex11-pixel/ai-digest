{
  "permissions": {
    "allow": [
      "mcp__tavily__tavily_search",
      "WebFetch(domain:docs.docker.com)",
      "WebFetch(domain:www.theregister.com)",
      "Bash(mkdir -p \"c:/Users/1/Downloads/ai-digest-main/src/assets/covers\")",
      "Bash(curl -fsSL \"https://image.pollinations.ai/prompt/Editorial%20illustration%20about%20an%20AI%20coding%20agent%20orchestrating%20parallel%20tasks%20in%20a%20computer%20terminal%2C%20minimalist%2C%20flat%20colors%2C%20tech%20magazine%20style%2C%20no%20text?width=1280&height=720&nologo=true\" -o \"c:/Users/1/Downloads/ai-digest-main/src/assets/covers/2026-08-11-meta-muse-code.jpg\")",
      "Bash(mkdir -p src/assets/covers)",
      "Bash(curl -fsSL \"https://image.pollinations.ai/prompt/Editorial%20illustration%20about%20microVM%20sandbox%20isolation%20for%20AI%20coding%20agents%2C%20minimalist%2C%20flat%20colors%2C%20tech%20magazine%20style%2C%20no%20text?width=1280&height=720&nologo=true\" -o \"src/assets/covers/2026-08-11-docker-sandboxes-microvm.jpg\")"
    ],
    "deny": [
      "Read(**/.env*)",
      "Read(**/credentials*)",
      "Read(**/*secret*)",
      "Read(/proc/self/environ)",
      "Read(**/environ)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(export -p*)",
      "Bash(declare -x*)",
      "Bash(set)",
      "Bash(set -o posix*)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/block-main-push.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pipeline-log.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/validate-article.js"
          }
        ]
      }
    ]
  }
}
